# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (T2S App)
# ==============================================================================
# Copy this file to `.env.local` in your project root directory:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gen AI Platform Modes
# ------------------------------------------------------------------------------
# Choose one of the two modes below depending on your environment:

# OPTION A: Google Cloud Vertex AI (Enterprise / Production on Cloud Run)
# Set GOOGLE_GENAI_USE_VERTEXAI to "true" to use Google Cloud Vertex AI API.
# Note: Ensure you run `gcloud auth application-default login` on your local
# machine for local development authentication, or configure Service Accounts on Cloud Run.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT="your-gcp-project-id-here"
GOOGLE_CLOUD_LOCATION="us-central1" # Keep us-central1 (recommended for Gemini TTS)

# OPTION B: Google AI Studio (Fast-Track Developer Mode - Zero Config)
# If GOOGLE_GENAI_USE_VERTEXAI is "false" or omitted, the application will fallback
# to using Google AI Studio. Fill this key to start coding in under 30 seconds.
# Get a free key at: https://aistudio.google.com/
# GEMINI_API_KEY="AIzaSyYourGeminiAIStudioAPIKeyHere"


# ------------------------------------------------------------------------------
# 2. Application URL
# ------------------------------------------------------------------------------
# Used for SEO, Sitemap, and Payment Callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# 3. Firebase Client Configuration (For Authentication)
# ------------------------------------------------------------------------------
# Get these credentials from your Firebase Console (https://console.firebase.google.com/)
# Project Settings -> General -> Your Apps -> Web App (Register a new Web App if missing).
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseWebAPIKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-firebase-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-firebase-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:sender_id:web:your_app_hash_id"

# ------------------------------------------------------------------------------
# 3. DOKU Payment Gateway (Checkout V2)
# ------------------------------------------------------------------------------
# Get these credentials from your DOKU Dashboard (Sandbox or Production).
DOKU_CLIENT_ID="your-doku-client-id"
DOKU_SECRET_KEY="your-doku-secret-key"
DOKU_API_BASE_URL="https://api-sandbox.doku.com" # https://api.doku.com for production
DOKU_NOTIFICATION_URL="https://your-domain.com/api/webhooks/doku"
